NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Comma-separated list of emails allowed into admin.
WITA_ADMIN_EMAILS=admin@example.com,second-admin@example.com

# Localhost-only dev bypass (never enable in production):
# 1 = bypass admin OAuth checks in local development
WITA_DEV_BYPASS_ADMIN=0
