    "lint": "node ./node_modules/next/dist/bin/next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "14.2.10",
    "next-auth": "^4.24.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
