{
  "name": "wita-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9 <25"
  },
  "scripts": {
    "predev": "node ./scripts/check-runtime.cjs",
    "prebuild": "node ./scripts/check-runtime.cjs",
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "dev:clean": "rm -rf .next && node ./node_modules/next/dist/bin/next dev",
    "build": "node ./node_modules/next/dist/bin/next build",
